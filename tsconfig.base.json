{
  "compilerOptions": {
    "baseUrl": ".",
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@workspace/api-client-react": ["./lib/api-client-react/src/index.ts"],
      "@workspace/api-zod": ["./lib/api-zod/src/index.ts"],
      "@workspace/db": ["./lib/db/src/index.ts"],
      "@workspace/db/schema": ["./lib/db/src/schema/index.ts"],
      "@workspace/integrations-openai-ai-react": ["./lib/integrations-openai-ai-react/src/index.ts"],
      "@workspace/integrations-openai-ai-server": ["./lib/integrations-openai-ai-server/src/index.ts"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query/src/index.ts"]
    },
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": false,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "types": [],
    "customConditions": ["workspace"]
  }
}
