{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.mjs",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/shopping-agent run dev",
    "dev": "pnpm -r --parallel --filter @workspace/api-server --filter @workspace/shopping-agent run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.59.0",
    "lightningcss-win32-x64-msvc": "1.31.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
